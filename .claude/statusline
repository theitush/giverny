#!/bin/sh
# This repo's status line (giverny#153). In a Giverny tab it is integ's own
# `giverny statusline` — the release build, the one path CLAUDE.md says never
# moves (giverny#148) — so the pane under development draws its own line.
#
# Anywhere else, and wherever integ has no build, it is the installed
# `giverny statusline`: the same command ~/.claude/settings.json runs, so the
# repo shows what every other repo shows. Until coo#225 this fell back to coo's
# pass panel, retired for giverny:manage.
if [ -n "$GIVERNY_TAB_ID" ]; then
  g=/home/ita/giverny/.claude/worktrees/integ/target/release/giverny
  if [ -x "$g" ]; then exec "$g" statusline 2>/dev/null; fi
fi
g=/home/ita/.config/giverny/bin/giverny
if [ -x "$g" ]; then exec "$g" statusline 2>/dev/null; fi
exit 0
