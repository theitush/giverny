{
  "env": {
    "FORCE_HYPERLINK": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/tree-watch pre >/dev/null 2>&1; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ita/coo/tools/tree-watch start >/dev/null 2>&1; exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "/home/ita/giverny/.claude/statusline",
    "type": "command",
    "refreshInterval": 1
  }
}
